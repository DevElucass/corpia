package br.com.corpia.service;

import java.util.List;

import org.springframework.ai.document.Document;
import org.springframework.ai.transformer.splitter.TokenTextSplitter;
import org.springframework.ai.vectorstore.SearchRequest;
import org.springframework.ai.vectorstore.VectorStore;
import org.springframework.stereotype.Service;

import br.com.corpia.util.ConhecimentoExtractor;

@Service
public class RagIndexService {

    private final ConhecimentoExtractor conhecimentoExtractor;
    private final VectorStore vectorStore;

    public RagIndexService(
            ConhecimentoExtractor conhecimentoExtractor,
            VectorStore vectorStore) {

        this.conhecimentoExtractor = conhecimentoExtractor;
        this.vectorStore = vectorStore;
    }

    /**
     * Indexa o documento de conhecimento padrão
     * usado pelo endpoint POST /rag/indexar.
     */
    public int indexarConhecimento() {

        String texto = conhecimentoExtractor.extrairTexto();

        return indexarDocumento(
                texto,
                "perfil_profissional.txt");
    }

    /**
     * Indexa um documento recebido dinamicamente,
     * como um currículo enviado pelo endpoint de upload.
     */
    public int indexarDocumento(
            String texto,
            String nomeArquivo) {

        if (texto == null || texto.isBlank()) {
            return 0;
        }

        Document documento = Document.builder()
                .text(texto)
                .metadata("source", nomeArquivo)
                .build();

        TokenTextSplitter splitter = TokenTextSplitter.builder()
                .build();

        List<Document> documentos = splitter.split(List.of(documento));

        vectorStore.add(documentos);

        return documentos.size();
    }

    /**
     * Executa uma busca diretamente no PGVector,
     * sem chamar o modelo de linguagem.
     *
     * Usado para diagnosticar quais chunks estão sendo
     * recuperados para uma determinada pergunta.
     */
    public List<Document> testarBusca(String pergunta) {

        if (pergunta == null || pergunta.isBlank()) {
            return List.of();
        }

        SearchRequest searchRequest = SearchRequest.builder()
                .query(pergunta)
                .topK(10)
                .similarityThreshold(0.10)
                .build();

        return vectorStore.similaritySearch(searchRequest);
    }
}